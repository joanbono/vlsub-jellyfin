<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <RootNamespace>Jellyfin.Plugin.VlsubGo</RootNamespace>
    <AssemblyName>Jellyfin.Plugin.VlsubGo</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!--
      ExcludeAssets="runtime" keeps the Jellyfin assemblies out of the plugin
      output. The host already provides them, and shipping copies risks loading
      a different build than the server is running.
    -->
    <PackageReference Include="Jellyfin.Controller" Version="10.11.*" ExcludeAssets="runtime" />
    <PackageReference Include="Jellyfin.Model" Version="10.11.*" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Configuration/configPage.html" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lets the test project reach internal helpers without making them public. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Jellyfin.Plugin.VlsubGo.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
